{{ if and (eq .chezmoi.os "linux") (default false (index . "localDesktop")) -}}
[Unit]
Description=Handle explicit niri lock requests
BindsTo=niri.service
After=niri.service
PartOf=graphical-session.target
ConditionEnvironment=XDG_CURRENT_DESKTOP=niri

[Service]
# No idle timeout during remote work; see docs/lockscreen.md.
ExecStart=/usr/bin/swayidle lock "%h/.local/bin/niri-lock"
Restart=on-failure
RestartSec=3
{{ end -}}
